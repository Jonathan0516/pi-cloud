# Copy to deploy/.env and fill in. Compose reads this file for ${...} interpolation.
# Generate secrets with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-40

# PostgreSQL superuser password (user `pi`, databases `pi` and `opensandbox`).
PG_PASSWORD=
# Host directory for the database files (an EBS volume on EC2).
PG_DATA=/data/pg
PG_PORT=5432

# OpenSandbox server API key; the node presents it on every sandbox call.
OPEN_SANDBOX_API_KEY=
# Sandbox image the node starts sessions from (build deploy/sandbox/Dockerfile and push it, or keep :local on a single host).
PI_SANDBOX_IMAGE=pi-sandbox:local
# Idle sandbox TTL. A sandbox in use renews it; this only decides how long a container waits
# for a user who walked away.
PI_SANDBOX_TIMEOUT_SECONDS=600
# Host directory whose per-session subdirectories become /workspace. Must match sandbox.toml allowed_host_paths.
WORKSPACES_ROOT=/data/workspaces

# Model proxy: the token-minting secret (>= 16 chars). Vendor API keys go in deploy/model-proxy.env, not here.
PI_MODEL_PROXY_SECRET=
PI_MODEL_PROXY_PROVIDERS=anthropic,openai,deepseek
# Initial model for new sessions, as provider/modelId.
PI_DEFAULT_MODEL=deepseek/deepseek-v4-pro

# Gateway: where it listens on the host and which keys exist on first start (tenant:user:key,...).
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=7400
PI_GATEWAY_BOOTSTRAP_KEYS=

# Node identity and tuning.
PI_NODE_ID=node-1
PI_PG_SCHEMA=pi_cloud
PI_WORKER_IDLE_GRACE_MS=30000
# Reclaim a session workspace left idle this long. 0 keeps every directory forever.
PI_WORKSPACE_RETENTION_DAYS=14
PI_LEASE_TTL_SECONDS=30
